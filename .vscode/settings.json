
{
    "java.configuration.updateBuildConfiguration": "interactive",
    "java.configuration.runtimes": [
        {
            "name": "JavaSE-26",
            "path": "/Library/Java/JavaVirtualMachines/jdk-26.jdk/Contents/Home",
            "default": true
        }
    ],
    "java.compile.nullAnalysis.mode": "automatic",
    "java.errors.incompleteClasspath.severity": "warning",

    "[java]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "redhat.java",
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
        }
    },

    "java.completion.importOrder": [
        "java",
        "javax",
        "jakarta",
        "org",
        "com"
    ],
    "java.sources.organizeImports.starThreshold": 99,
    "java.sources.organizeImports.staticStarThreshold": 99,
    "java.inlayHints.parameterNames.enabled": "literals",

    "java.import.maven.enabled": true,
    "java.import.gradle.enabled": true,
    "maven.executable.preferMavenWrapper": true,
    "maven.terminal.useJavaHome": true,

    "java.debug.settings.showQualifiedNames": true,
    "java.debug.settings.showStaticVariables": true,
    "java.test.defaultConfig": "default",

    "editor.minimap.enabled": false,
    "editor.rulers": [100],
    "editor.renderWhitespace": "selection",
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": "active",
    "editor.suggestSelection": "first",
    "editor.tabCompletion": "on",

    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "files.encoding": "utf8",

    "[xml]": {
        "editor.formatOnSave": true,
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "[yaml]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true
    },
    "[json]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },

    "workbench.editorAssociations": {
        "*.xml": "default"
    },

    "terminal.integrated.defaultProfile.osx": "zsh",
    "terminal.integrated.scrollback": 10000
}
